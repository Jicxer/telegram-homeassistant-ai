# Copy this file to .env and fill in your values
# NEVER commit .env to git — it contains secrets

# ── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
ALLOWED_USER_ID=your_telegram_user_id_here

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_MODEL=mistral
OLLAMA_HOST=http://localhost:11434

# ── Smart plug (Shelly Gen2, local network IP only) ──────────────────────────
SHELLY_DEVICE_IP=your_shelly_ip_here

# ── Weather ──────────────────────────────────────────────────────────────────
WEATHER_LOCATION=Portland,OR

# ── Wake-on-LAN relay (RPI) ──────────────────────────────────────────────────
# Tailscale IP of the RPI used to send WOL magic packets
RPI_HOST=your_rpi_tailscale_ip_here
# SSH username on the RPI
RPI_USER=your_rpi_username_here

# ── Remote machine targets ────────────────────────────────────────────────────
# Add one HOST and USER entry per machine you want to control.
# Name must match what you type in /shutdown and /reboot commands.
# The user must have sudo privileges on the target machine.
# SSH key (~/.ssh/id_ed25519) must be in that user's authorized_keys.
#
# Format:
#   MACHINE_<NAME>_HOST=tailscale_ip
#   MACHINE_<NAME>_USER=ssh_username
#
MACHINE_DESKTOP_HOST=your_desktop_tailscale_ip_here
MACHINE_DESKTOP_USER=your_desktop_username_here

MACHINE_LAPTOP2_HOST=your_laptop2_tailscale_ip_here
MACHINE_LAPTOP2_USER=your_laptop2_username_here

# ── Protected machines ────────────────────────────────────────────────────────
# Comma-separated list of machine names that cannot be targeted by
# /shutdown or /reboot. Always include the server running this bot.
PROTECTED_MACHINES=laptop
